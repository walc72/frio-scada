# =============================================================================
# Frío SCADA - Environment Variables Template
# Copy this to .env and fill in your values
# =============================================================================

# Timezone
TZ=America/Asuncion

# InfluxDB
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-me
INFLUXDB_ORG=tecnoelectric
INFLUXDB_BUCKET=camaras
INFLUXDB_TOKEN=change-me
# Este token también se usa en el poller y la API (sobrescribe config.json)
# Token de SOLO LECTURA del bucket para Grafana. Lo crea el instalador
# (crear-token-grafana.sh); vacío = los paneles de Grafana no cargan.
INFLUXDB_GRAFANA_TOKEN=

# --- Retención y backups ---
# Retención del bucket (3 años). frio-backup la fija al arrancar; también aplica al init.
INFLUXDB_RETENTION=1095d
# Backup mensual (día 1, 03:00): carpeta local, rotación y guardián de disco
BACKUP_LOCAL_DIR=./backups
BACKUP_KEEP=12
DISK_FLOOR_GB=15
# Segundo destino (disco externo / carpeta de red): descomentar el volumen
# "<ruta>:/external" en el servicio backup del docker-compose y setear:
BACKUP_EXTERNAL=

# Grafana
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me

# SMTP (configure when needed)
GF_SMTP_USER=your-email@gmail.com
GF_SMTP_PASSWORD=your-app-password
GF_SMTP_FROM=your-email@gmail.com

# Alert notifications (también editables en Configuración; el instalador los escribe acá)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Reporte diario automático (lo genera frio-api con el histórico de InfluxDB)
#   - Cada día a DAILY_REPORT_HOUR genera el Excel de cámaras del día anterior en REPORTS_DIR
#   - Si hay SMTP (GF_SMTP_USER/PASSWORD) y un destinatario, lo envía por email
#   - Los Excel diarios se guardan en la carpeta REPORTS_DIR (por defecto ./reports)
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR=7
# Destinatario(s) del reporte diario (coma-separado). Vacío usa ALERT_EMAIL.
DAILY_REPORT_EMAIL=
# Carpeta local donde se acumulan los Excel diarios (host). Puede ser un disco/red.
REPORTS_DIR=./reports

# Tailscale (leave empty for manual auth)
TS_AUTHKEY=

# =============================================================================
# API Auth — dos roles: admin (todo, incl. Configuración) y operador (solo ve)
# =============================================================================
# Cada credencial admite password en texto plano o, PREFERIDO, hash scrypt.
# Generar un hash:  node scripts/hash-password.js 'tu-password'
#   -> imprime  scrypt$<salt>$<hash>  para poner en *_HASH (dejar el plano vacío)

# --- admin (acceso total) ---
AUTH_USER=admin
AUTH_PASSWORD=change-me
# AUTH_PASSWORD_HASH=scrypt$....   # si se define, ignora AUTH_PASSWORD

# --- operador (solo lectura: dashboards, históricos, reportes; sin Configuración) ---
# Dejar ambos vacíos para deshabilitar el rol operador.
OPERADOR_USER=operador
OPERADOR_PASSWORD=
# OPERADOR_PASSWORD_HASH=scrypt$....

# CORS: origen del frontend (p.ej. https://scada.midominio.com o * para dev)
ALLOWED_ORIGIN=*

# =============================================================================
# Réplica de oficina (API /api/replica, solo lectura)
# =============================================================================
# En PLANTA: token que usa el servidor de oficina para leer. Vacío = apagada.
# Generar:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPLICA_TOKEN=
# En la OFICINA (docker-compose.replica.yml): URL de planta y el mismo token.
# REPLICA_SOURCE=http://100.64.0.1:9090
# Nuevo: las réplicas se enlazan desde Configuración (código de enlace);
# REPLICA_TOKEN/REPLICA_SOURCE quedan como método heredado.

# =============================================================================
# Agente del sistema (Configuración → Conexión: Tailscale desde la web)
# =============================================================================
# Secreto entre frio-api y frio-agent. Generar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN=
